#!/usr/bin/env python3
"""Alphalens Service Manager - Interactive Menu Mode.

Usage:
    ./alphalens                 Interactive menu mode
    ./alphalens --mode prod     Production mode
    ./alphalens <command> ...   Run a manage.py command directly
"""

import os
import sys
import subprocess

MANAGE_PY = os.path.join(os.path.dirname(os.path.dirname(__file__)), "manage.py")


def main():
    if len(sys.argv) > 1 and sys.argv[1] not in ("--mode",):
        cmd = [sys.executable, MANAGE_PY] + sys.argv[1:]
    else:
        cmd = [sys.executable, MANAGE_PY, "menu"] + sys.argv[1:]

    result = subprocess.run(cmd)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
